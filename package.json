{
  "name": "fitness-log",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "db:local": "wrangler d1 migrations apply fitness-log-db --local",
    "db:remote": "wrangler d1 migrations apply fitness-log-db --remote",
    "secrets:local": "bash scripts/dev-vars.sh",
    "secrets:push": "doppler secrets get ANTHROPIC_API_KEY --plain | wrangler secret put ANTHROPIC_API_KEY",
    "preview": "vite build && npm run secrets:local && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wrangler": "^3.78.0"
  }
}
